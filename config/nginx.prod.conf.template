map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Limita por IP real del cliente. Detras de un ingress que define X-Forwarded-For
# se usa el primer valor; si no hay header, cae en la IP del peer.
map $http_x_forwarded_for $client_ip {
    ~^([^,]+)  $1;
    default    $binary_remote_addr;
}

limit_req_zone $client_ip zone=api_limit:10m rate=300r/m;
limit_req_zone $client_ip zone=auth_limit:10m rate=20r/m;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    access_log off;

    include /etc/nginx/snippets/security-headers.conf;

    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;

    location ^~ /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass ${API_URL};
    }

    location ^~ /api/ {
        limit_req zone=api_limit burst=50 nodelay;
        proxy_pass ${API_URL};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
